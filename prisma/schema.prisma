generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEAD_EXAMINER
  SOC_SUPERVISOR
  AUDITOR
}

enum OperationalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OperationalCaseStatus {
  OPEN
  IN_INVESTIGATION
  ESCALATED
  CLOSED
  REOPENED
}

enum OperationalInvestigationStatus {
  IN_PROGRESS
  COMPLETED
  SUSPENDED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  auditLogs AuditLog[]
  entities  OperationalEntity[]
  alerts    OperationalAlert[]
  cases     OperationalCase[]
}

model OperationalEntity {
  id             String   @id
  organizationId String
  name           String
  code           String
  criticality    OperationalSeverity
  sector         String
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  alerts       OperationalAlert[]
  cases        OperationalCase[]

  @@index([organizationId, criticality])
}

model OperationalAlert {
  id             String   @id
  organizationId String
  entityId       String
  title          String
  severity       OperationalSeverity
  status         String
  payload        Json?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entity       OperationalEntity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  cases        OperationalCase[]

  @@index([organizationId, severity, createdAt])
  @@index([entityId])
}

model OperationalCase {
  id             String                 @id
  organizationId String
  entityId       String
  alertId        String
  caseNumber     String
  title          String
  severity       OperationalSeverity
  status         OperationalCaseStatus
  assignedAnalyst String?
  payload        Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entity       OperationalEntity        @relation(fields: [entityId], references: [id], onDelete: Restrict)
  alert        OperationalAlert         @relation(fields: [alertId], references: [id], onDelete: Restrict)
  investigations OperationalInvestigation[]
  evidence       OperationalEvidence[]

  @@unique([organizationId, caseNumber])
  @@index([organizationId, status, severity])
  @@index([assignedAnalyst])
}

model OperationalInvestigation {
  id             String                       @id
  caseId         String
  organizationId String
  status         OperationalInvestigationStatus
  analystId      String?
  payload        Json?
  startedAt      DateTime
  completedAt    DateTime?

  case OperationalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([caseId])
}

model OperationalEvidence {
  id             String   @id
  caseId         String
  organizationId String
  evidenceType   String
  verified       Boolean  @default(false)
  payload        Json?
  collectedAt    DateTime

  case OperationalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([organizationId, verified])
  @@index([caseId])
}

model FindingRecord {
  id             String   @id
  organizationId String
  caseId         String
  entityId       String
  severity       OperationalSeverity
  reviewStatus   String
  payload        Json
  reviewDecision Json?
  createdAt      DateTime
  updatedAt      DateTime @updatedAt

  @@index([organizationId, reviewStatus])
  @@index([caseId])
  @@index([entityId, severity])
}

model User {
  id           String        @id @default(cuid())
  organizationId String
  email        String        @unique
  name         String
  role         UserRole
  passwordHash String
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions     RefreshSession[]
  auditLogs    AuditLog[]    @relation("AuditActor")

  @@index([organizationId, role])
}

model RefreshSession {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model ScenarioSnapshot {
  id         String   @id @default(cuid())
  scenarioId String   @unique
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([updatedAt])
}
